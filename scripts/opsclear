    return EXIT_OK


# --------------------------------------------------------------------------- commands: pr sync (ADR-0055)

JOB_REF_RE = re.compile(r"\bJOB-\d+\b", re.IGNORECASE)
CLOSES_LINE_RE = re.compile(r"^\s*(Closes|Part of)\s+(JOB-\d+(?:\s*,\s*JOB-\d+)*)", re.IGNORECASE | re.MULTILINE)
HTML_COMMENT_RE = re.compile(r"<!--.*?-->", re.DOTALL)
PR_ACTIONS = ("opened", "edited", "reopened", "closed")


@dataclass
class PrEvent:
    action: str
    number: int
    url: str
    title: str
    body: str
    branch: str
    merged: bool = False
    state: str = "open"  # the PR's state when the event fired: open or closed


def strip_html_comments(text: Optional[str]) -> str:
    return HTML_COMMENT_RE.sub("", text or "")


def _unique(items: List[str]) -> List[str]:
    seen: List[str] = []
    for item in items:
        if item not in seen:
            seen.append(item)
    return seen


def parse_pr_refs(branch: str, title: str, body: Optional[str]) -> Tuple[List[str], List[str]]:
    """Return (refs, closes): every job the PR references and the ones it closes.

    refs = JOB-x in branch and title, plus `Closes` / `Part of` lines in the body (HTML comments
    stripped). Other mentions in the body are ignored. closes = jobs on `Closes` lines."""
    refs = [m.upper() for m in JOB_REF_RE.findall(branch or "")]
    refs += [m.upper() for m in JOB_REF_RE.findall(title or "")]
    closes: List[str] = []
    for m in CLOSES_LINE_RE.finditer(strip_html_comments(body)):
        found = [j.upper() for j in JOB_REF_RE.findall(m.group(2))]
        refs += found
        if m.group(1).lower() == "closes":
            closes += found
    return _unique(refs), _unique(closes)


def pr_link_label(event: PrEvent) -> str:
    label = f"PR #{event.number}: {event.title.strip()}" if event.title.strip() else f"PR #{event.number}"
    return label[:LINK_LABEL_MAX]


@dataclass
class Step:
    """One planned change to one job."""
    text: str
    write: Optional[Write] = None
    needs_confirm: bool = False
    note: bool = False  # information only, nothing to send


def plan_job_changes(event: PrEvent, project_id: str, job: Dict[str, Any], closes: bool) -> List[Step]:
    """The ADR-0055 event table for one job, from the job's current state. Pure: sends nothing."""
    fid = job["friendlyId"]
    base = job_path(project_id, fid)
    link = next((lk for lk in job.get("links") or [] if same_url(lk.get("url"), event.url)), None)
    status = job.get("status")
    steps: List[Step] = []

    def relabel(label: str) -> None:
        if link is not None and label != link.get("label"):
            steps.append(Step(f"relabel link {link.get('label')!r} -> {label!r}",
                              Write("PUT", base + f"/links/{quote(link['id'])}",
                                    {"url": link["url"], "label": label})))

    def add_link(label: str) -> None:
        steps.append(Step(f"add link {label!r}", Write("POST", base + "/links", {"url": event.url, "label": label})))

    def move(target: str) -> None:
        steps.append(Step(f"status -> {target}", Write("PATCH", base + "/status", {"status": target}),
                          needs_confirm=target != "IN_PROGRESS"))

    # An edit to a PR that is already closed or merged only keeps its link label right: no status moves.
    edited_after_close = event.action == "edited" and event.state != "open"
    if edited_after_close:
        label = merged_label if event.merged else closed_label
        suffix = MERGED_SUFFIX if event.merged else CLOSED_SUFFIX
        if link is None:
            add_link(with_suffix(pr_link_label(event), suffix))
        else:
            relabel(label(link.get("label")))
    elif event.action in ("opened", "edited", "reopened"):
        if link is None:
            add_link(pr_link_label(event))
        elif event.action == "reopened":
            relabel(base_label(link.get("label")))
        if status == "NEW":
            move("IN_PROGRESS")
        elif status == "COMPLETED":
            steps.append(Step("already Completed, status left as is", note=True))
    elif event.action == "closed" and event.merged:
        if link is None:
            add_link(with_suffix(pr_link_label(event), MERGED_SUFFIX))
        else:
            relabel(merged_label(link.get("label")))
        if closes:
            if status in ("NEW", "BLOCKED"):
                move("IN_PROGRESS")
            if status != "COMPLETED":
                move("COMPLETED")
        elif status == "NEW":
            move("IN_PROGRESS")
    elif event.action == "closed":
        if link is None:
            add_link(with_suffix(pr_link_label(event), CLOSED_SUFFIX))
        else:
            relabel(closed_label(link.get("label")))
    return steps


class Unreachable(CliError):
    """OpsClear stayed unreachable (or answered 5xx) through every retry."""


def retrying_transport(inner: Transport, delays: Tuple[float, ...], sleep: Callable[[float], None],
                       on_retry: Callable[[str, float], None]) -> Transport:
    """Retry connection errors and 5xx with the given delays. 4xx is returned as is."""
    def send(method: str, url: str, headers: Dict[str, str], data: Optional[bytes]) -> Response:
        attempt = 0
        while True:
            try:
                resp = inner(method, url, headers, data)
                if resp.status < 500:
                    return resp
                failure = f"HTTP {resp.status}"
            except Unreachable:
                raise
            except (CliError, OSError, http.client.HTTPException) as e:
                failure = str(e) or repr(e)
            if attempt >= len(delays):
                raise Unreachable(f"OpsClear unreachable after {attempt + 1} attempts: {failure}")
            on_retry(failure, delays[attempt])
            sleep(delays[attempt])
            attempt += 1
    return send


def read_pr_event(args) -> PrEvent:
    if args.event:
        try:
            with open(args.event, encoding="utf-8") as f:
                data = json.load(f)
        except OSError as e:
            raise argparse.ArgumentTypeError(f"cannot read event file {args.event}: {e.strerror}")
        except ValueError as e:
            raise argparse.ArgumentTypeError(f"event file {args.event} is not valid JSON: {e}")
        pr = data.get("pull_request") if isinstance(data, dict) else None
        if not isinstance(pr, dict):
            raise argparse.ArgumentTypeError("event file has no pull_request")
        return PrEvent(
            action=str(data.get("action") or ""), number=int(pr.get("number") or 0),
            url=str(pr.get("html_url") or ""), title=str(pr.get("title") or ""), body=str(pr.get("body") or ""),
            branch=str((pr.get("head") or {}).get("ref") or ""), merged=bool(pr.get("merged")),
            state=str(pr.get("state") or "open").lower())
    missing = [f for f in ("action", "number", "url") if not getattr(args, f)]
    if missing:
        raise argparse.ArgumentTypeError("pr sync needs --event, or --action, --number and --url: missing "
                                         + ", ".join("--" + m for m in missing))
    return PrEvent(action=args.action, number=args.number, url=args.url, title=args.title or "",
                   body=read_text(args.body_file) if args.body_file else "", branch=args.branch or "",
                   merged=args.merged, state=args.state)


def applied_already(ctx: Ctx, write: Write) -> bool:
    """After a retried status PATCH got 400: did an earlier attempt already apply it? Re-reads the job."""
    target = (write.body or {}).get("status")
    current = ctx.api.get(write.path.rsplit("/status", 1)[0]).get("status")
    return current == target or (current == "COMPLETED" and target == "IN_PROGRESS")


def md_cell(text: str) -> str:
    return text.replace("|", "\\|").replace("\n", " ")


def cmd_pr_sync(ctx: Ctx, args) -> int:
    event = read_pr_event(args)
    out = ctx.out
    if event.action not in PR_ACTIONS:
        out.print(f"Nothing to sync: PR action {event.action!r} is not one of {', '.join(PR_ACTIONS)}.")
        return EXIT_OK
    refs, closes = parse_pr_refs(event.branch, event.title, event.body)
    retries = [0]
    rows: List[Tuple[str, str, str]] = []

    def record(job_id: str, change: str, result: str) -> None:
        rows.append((job_id, change, result))
        out.print(f"{job_id}: {change}: {result}")

    def warn(job_id: str, message: str) -> None:
        rows.append((job_id, message, "warning"))
        out.print(f"::warning::{job_id}: {message}")

    suffix = " (merged)" if event.merged and event.action == "closed" else ""
    out.print(f"PR #{event.number} {event.action}{suffix}: "
              f"{', '.join(refs) if refs else 'no job referenced'}")
    if not refs:
        out.print("Nothing synced: the PR references no OpsClear job.")
    else:
        ctx.api.transport = retrying_transport(
            ctx.api.transport, ctx.retry_delays, ctx.sleep,
            lambda why, delay: (retries.__setitem__(0, retries[0] + 1), out.print(f"OpsClear not answering ({why}), retrying in {delay:g}s")))
    for index, job_id in enumerate(refs):
        try:
            project, job = find_job(ctx, job_id)
            steps = plan_job_changes(event, project["friendlyId"], job, job_id in closes)
            if not steps:
                record(job_id, "nothing to change", "ok")
            for step in steps:
                if step.note:
                    record(job_id, step.text, "ok")
                elif ctx.dry_run:
                    record(job_id, step.text, "dry run, nothing sent")
                elif step.needs_confirm and not ctx.yes:
                    record(job_id, step.text, "not applied, re-run with --yes")
                    break
                else:
                    before = retries[0]
                    try:
                        ctx.api.request(step.write.method, step.write.path, step.write.body)
                    except ApiError as e:
                        if not (e.status == 400 and retries[0] > before and step.write.method == "PATCH"
                                and applied_already(ctx, step.write)):
                            raise
                        record(job_id, step.text, "done (applied by an earlier attempt)")
                        continue
                    requested = step.text.endswith("COMPLETED") and ctx.api.last_status == 202
                    record(job_id, step.text, "completion requested" if requested else "done")
        except Unreachable as e:
            warn(job_id, f"{e}. Skipping this and the remaining jobs.")
            for rest in refs[index + 1:]:
                warn(rest, "skipped: OpsClear unreachable")
            break
        except CliError as e:
            warn(job_id, f"skipped: {e}")
    if args.summary:
        lines = [f"### OpsClear job sync: PR #{event.number} {event.action}{suffix}", ""]
        if rows:
            lines += ["| Job | Change | Result |", "|---|---|---|"]
            lines += [f"| {md_cell(j)} | {md_cell(c)} | {md_cell(r)} |" for j, c, r in rows]
        else:
            lines.append("No job referenced, nothing synced.")
        try:
            with open(args.summary, "a", encoding="utf-8") as f:
                f.write("\n".join(lines) + "\n")
        except OSError as e:
            out.print(f"::warning::cannot write summary {args.summary}: {e.strerror}")
    return EXIT_OK


# --------------------------------------------------------------------------- commands: pr check (ADR-0056)

# The naming rules (docs/dev/process/NAMING.md). The doc-sync test fails if NAMING.md differs.
TYPES = ("feat", "fix", "docs", "refactor", "test", "chore")
SCOPES = ("backend", "frontend", "db", "e2e", "auth", "config", "ci", "docs", "deps", "infra", "adr")
BRANCH_PREFIXES = ("feature", "fix", "e2e", "chore")
CROSS_LAYER_LABEL = "cross-layer"
# Layer -> path prefixes. First match wins, so db comes before backend. Everything else is neutral.
LAYER_PATHS = (
    ("db", ("backend/src/main/resources/db/migration/", "backend/src/main/generated/")),
    ("backend", ("backend/",)),
    ("frontend", ("frontend/",)),
)
NEUTRAL_PATHS = ("frontend/cypress/",)  # under a layer's root but belongs to none
AI_TOOLS = ("Claude", "Anthropic", "Copilot", "OpenAI", "ChatGPT", "Gemini", "Cursor")
AI_ATTRIBUTION_RE = re.compile(
    r"^[ \t>*-]*co-authored-by:[^\n]*(?:" + "|".join(AI_TOOLS) + r")|generated with\W*claude code",
    re.IGNORECASE | re.MULTILINE)
PLACEHOLDER_RE = re.compile(r"\bJOB-_+", re.IGNORECASE)
TITLE_RE = re.compile(r"^(?P<type>[^(:\s]*)(?:\((?P<scope>[^)]*)\))?: (?P<rest>.*)$", re.DOTALL)
TITLE_JOBS_RE = re.compile(r"^(?P<summary>.*\S) \((?P<jobs>JOB-\d+(?:, JOB-\d+)*)\)$", re.DOTALL)
BRANCH_RE = re.compile(r"^(?P<prefix>[^/]+)/(?P<job>JOB-\d+)-(?P<slug>[a-z0-9-]+)$")
MAX_CHECK_FILES = 3000  # the GitHub files API returns at most this many
CHECK_RETRY_DELAYS = (2, 4, 8)  # seconds, brief
GITHUB_API_URL = "https://api.github.com"


def fmt_list(items) -> str:
    return " ".join(f"`{i}`" for i in items)


def layer_of(path: str) -> str:
    """db, backend, frontend, or neutral."""
    if path.startswith(NEUTRAL_PATHS):
        return "neutral"
    for layer, prefixes in LAYER_PATHS:
        if path.startswith(prefixes):
            return layer
    return "neutral"


def layers_touched(files: List[str]) -> List[str]:
    found = {layer_of(f) for f in files}
    return [layer for layer, _ in LAYER_PATHS if layer in found]


@dataclass
class CheckResult:
    name: str
    problem: str = ""  # empty means pass
    fix: str = ""
    detail: str = ""  # shown in the table when passing, or extra context when failing

    @property
    def ok(self) -> bool:
        return not self.problem


def title_jobs(title: str) -> List[str]:
    m = TITLE_JOBS_RE.match(title or "")
    return JOB_REF_RE.findall(m.group("jobs")) if m else []


def check_title(title: str) -> CheckResult:
    r = CheckResult("PR title")
    example = "feat(backend): add org-level template CRUD (JOB-109)"
    shape = f"Use `<type>(<scope>): <summary> (JOB-x)`, e.g. `{example}`."
    m = TITLE_RE.match(title or "")
    if not m:
        r.problem, r.fix = f"title {title!r} does not match the format", shape
        return r
    if m.group("type") not in TYPES:
        r.problem = f"unknown type {m.group('type')!r}"
        r.fix = f"Use one of {fmt_list(TYPES)}."
        return r
    if m.group("scope") is None:
        r.problem = "missing scope"
        r.fix = f"Add a scope from {fmt_list(SCOPES)}, e.g. `{m.group('type')}(backend): ...`."
        return r
    if m.group("scope") not in SCOPES:
        r.problem = f"unknown scope {m.group('scope')!r}"
        r.fix = f"Use one of {fmt_list(SCOPES)}."
        return r
    if not TITLE_JOBS_RE.match(m.group("rest")):
        r.problem = "missing job ID at the end, or empty summary"
        r.fix = "End the title with the OpsClear job, `(JOB-123)` or `(JOB-1, JOB-2)`. " + shape
        return r
    r.detail = ", ".join(title_jobs(title))
    return r


def check_branch(branch: str, jobs: List[str]) -> CheckResult:
    r = CheckResult("Branch name")
    shape = f"Use `<{'|'.join(BRANCH_PREFIXES)}>/JOB-x-<slug>` with a slug of `a-z0-9-`, e.g. `chore/JOB-324-pr-check`."
    m = BRANCH_RE.match(branch or "")
    if not m or m.group("prefix") not in BRANCH_PREFIXES:
        r.problem, r.fix = f"branch {branch!r} does not match the format", shape
    elif jobs and m.group("job") not in jobs:
        r.problem = f"branch job {m.group('job')} is not one of the title's ({', '.join(jobs)})"
        r.fix = "Name the branch after a job in the PR title."
    else:
        r.detail = branch
    return r


def check_body(body: str, jobs: List[str]) -> CheckResult:
    r = CheckResult("PR body")
    text = strip_html_comments(body)
    problems, fixes = [], []
    named = [j.upper() for m in CLOSES_LINE_RE.finditer(text) for j in JOB_REF_RE.findall(m.group(2))]
    if not named:
        problems.append("no `Closes JOB-x` or `Part of JOB-x` line")
        fixes.append("Add a line `Closes JOB-x` (or `Part of JOB-x` if more PRs follow) on its own.")
    elif jobs and not set(named) & set(jobs):
        problems.append(f"`Closes` / `Part of` names {', '.join(named)}, none of the title's jobs ({', '.join(jobs)})")
        fixes.append("Name a job from the PR title on the `Closes` / `Part of` line.")
    if PLACEHOLDER_RE.search(text):
        problems.append("unfilled `JOB-___` placeholder")
        fixes.append("Replace the `JOB-___` placeholder with the real job ID.")
    if AI_ATTRIBUTION_RE.search(text):
        problems.append("AI attribution")
        fixes.append("Remove the AI `Co-Authored-By` trailer or 'Generated with Claude Code' line.")
    r.problem, r.fix = "; ".join(problems), " ".join(fixes)
    if r.ok:
        r.detail = ", ".join(_unique(named))
    return r


def check_layers(files: List[str], labels: List[str]) -> CheckResult:
    r = CheckResult("Layers")
    if len(files) >= MAX_CHECK_FILES:
        r.problem = f"{len(files)} changed files, GitHub lists at most {MAX_CHECK_FILES}"
        r.fix = "Split the PR: it is too large to check or review."
        return r
    layers = layers_touched(files)
    r.detail = ", ".join(layers) if layers else "neutral paths only"
    if len(layers) >= 2:
        if CROSS_LAYER_LABEL in [label.lower() for label in labels]:
            r.detail += f" (allowed by the `{CROSS_LAYER_LABEL}` label)"
        else:
            r.problem = f"touches {len(layers)} layers: {', '.join(layers)}"
            r.fix = (f"Split the PR so it touches one of db / backend / frontend, or add the "
                     f"`{CROSS_LAYER_LABEL}` label if the PR can't be split.")
    return r


def run_checks(title: str, body: str, branch: str, labels: List[str], files: List[str]) -> List[CheckResult]:
    return [check_title(title), check_branch(branch, title_jobs(title)), check_body(body, title_jobs(title)),
            check_layers(files, labels)]


def gh_escape(text: str, prop: bool = False) -> str:
    text = text.replace("%", "%25").replace("\r", "%0D").replace("\n", "%0A")
    return text.replace(":", "%3A").replace(",", "%2C") if prop else text


def fetch_pr_files(ctx: Ctx, repo: str, number: int, token: str, base_url: str) -> List[str]:
    """Filenames (and old names of renames) from the PR files API: paginated, brief retry, then fail."""
    files: List[str] = []
    headers = {"Authorization": f"Bearer {token}", "Accept": "application/vnd.github+json",
               "X-GitHub-Api-Version": "2022-11-28", "User-Agent": "opsclear-pr-check"}
    page = 1
    while True:
        url = f"{base_url.rstrip('/')}/repos/{repo}/pulls/{number}/files?per_page=100&page={page}"
        attempt = 0
        while True:
            failure = ""
            fatal = False
            try:
                resp = ctx.api.transport("GET", url, headers, None)
                if resp.status == 200:
                    break
                failure = f"GitHub returned {resp.status}: {_error_message(resp.body)}"
                fatal = resp.status < 500 and resp.status not in (403, 429)
            except CliError as e:
                failure = str(e)
            if fatal or attempt >= len(CHECK_RETRY_DELAYS):
                raise CliError(f"cannot list the PR's files after {attempt + 1} attempt(s): {failure}")
            ctx.sleep(CHECK_RETRY_DELAYS[attempt])
            attempt += 1
        items = json.loads(resp.body or b"[]")
        for item in items:
            files.append(str(item.get("filename") or ""))
            if item.get("previous_filename"):
                files.append(str(item["previous_filename"]))
        if len(items) < 100 or len(files) >= MAX_CHECK_FILES:
            return files
        page += 1


def run_git(args: List[str]) -> str:
    try:
        proc = subprocess.run(["git"] + args, capture_output=True, text=True, check=False)
    except OSError as e:
        raise CliError(f"cannot run git: {e.strerror}")
    if proc.returncode != 0:
        raise CliError(f"git {' '.join(args)} failed: {proc.stderr.strip() or proc.returncode}")
    return proc.stdout


def read_check_input(ctx: Ctx, args) -> Tuple[str, str, str, List[str], List[str]]:
    """(title, body, branch, labels, files) from the event file (CI) or from flags and git (local)."""
    if args.event:
        try:
            with open(args.event, encoding="utf-8") as f:
                data = json.load(f)
        except OSError as e:
            raise argparse.ArgumentTypeError(f"cannot read event file {args.event}: {e.strerror}")
        except ValueError as e:
            raise argparse.ArgumentTypeError(f"event file {args.event} is not valid JSON: {e}")
        pr = data.get("pull_request") if isinstance(data, dict) else None
        if not isinstance(pr, dict):
            raise argparse.ArgumentTypeError("event file has no pull_request")
        repo = str(((data.get("repository") or {}).get("full_name")) or ctx.env.get("GITHUB_REPOSITORY") or "")
        token = ctx.env.get("GITHUB_TOKEN") or ""
        if not repo or not token or not pr.get("number"):
            raise CliError("CI mode needs the repository (event file or GITHUB_REPOSITORY), the PR number "
                           "and GITHUB_TOKEN")
        files = fetch_pr_files(ctx, repo, int(pr["number"]), token, ctx.env.get("GITHUB_API_URL") or GITHUB_API_URL)
        labels = [str(label.get("name") or "") for label in pr.get("labels") or [] if isinstance(label, dict)]
        return (str(pr.get("title") or ""), str(pr.get("body") or ""),
                str((pr.get("head") or {}).get("ref") or ""), labels, files)
    if args.title is None:
        raise argparse.ArgumentTypeError("pr check needs --event, or --title (and usually --body-file)")
    branch = args.branch if args.branch is not None else run_git(["rev-parse", "--abbrev-ref", "HEAD"]).strip()
    files = [f for f in run_git(["diff", "--name-only", f"{args.base}...HEAD"]).splitlines() if f]
    labels = [label.strip() for label in (args.labels or "").split(",") if label.strip()]
    return args.title, read_text(args.body_file) if args.body_file else "", branch, labels, files


def cmd_pr_check(ctx: Ctx, args) -> int:
    title, body, branch, labels, files = read_check_input(ctx, args)
    results = run_checks(title, body, branch, labels, files)
    out = ctx.out
    for r in results:
        if r.ok:
            out.print(f"PASS  {r.name}: {r.detail}" if r.detail else f"PASS  {r.name}")
        else:
            out.print(f"::error title={gh_escape('Process check: ' + r.name, True)}::"
                      f"{gh_escape(r.problem + '. ' + r.fix)}")
    failed = [r for r in results if not r.ok]
    if args.summary:
        lines = ["### PR process check", "", "| Check | Result | Detail |", "|---|---|---|"]
        for r in results:
            detail = f"{r.problem}. {r.fix}" if r.problem else r.detail
            if r.problem and r.detail:
                detail += f" ({r.detail})"
            lines.append(f"| {md_cell(r.name)} | {'FAIL' if r.problem else 'pass'} | {md_cell(detail)} |")
        try:
            with open(args.summary, "a", encoding="utf-8") as f:
                f.write("\n".join(lines) + "\n")
        except OSError as e:
            out.print(f"::warning::cannot write summary {args.summary}: {e.strerror}")
    if failed:
        out.warn(f"PR check failed: {', '.join(r.name for r in failed)}.")
        return EXIT_ERROR
    return EXIT_OK


# --------------------------------------------------------------------------- argument parser


def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="machine-readable JSON output")
    common.add_argument("--yes", action="store_true", help="apply a change that needs confirmation")
    common.add_argument("--dry-run", action="store_true", help="print the requests a write would send; send nothing")

    def project_opt(p):
        p.add_argument("--project", type=friendly("PRJ"),
                       help="the job's project (skips searching every project)")

    parser = argparse.ArgumentParser(
        prog="opsclear", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    groups = parser.add_subparsers(dest="group", metavar="<command>", required=True)

    def group(name, help_text):
        g = groups.add_parser(name, help=help_text)
        return g.add_subparsers(dest="action", metavar="<action>", required=True)

    def cmd(sub, name, func, help_text):
        p = sub.add_parser(name, parents=[common], help=help_text, description=help_text)
        p.set_defaults(func=func)
        return p

    jobs = group("job", "read and change jobs")
    p = cmd(jobs, "get", cmd_job_get, "show a job with its project, links and relationships")
    p.add_argument("job", type=friendly("JOB"))
    project_opt(p)

    p = cmd(jobs, "list", cmd_job_list, "list a project's jobs (open ones by default)")
    p.add_argument("project", type=friendly("PRJ"))
    p.add_argument("--milestone", type=friendly("MIL"))
    p.add_argument("--status", type=choice(STATUSES + ("ALL", "OPEN")), default="OPEN",
                   help="OPEN (default, everything but COMPLETED), ALL, NEW, IN_PROGRESS, BLOCKED or COMPLETED")

    p = cmd(jobs, "create", cmd_job_create, "create a job from a template (needs --yes)")
    p.add_argument("project", type=friendly("PRJ"))
    p.add_argument("--template", required=True, help="template name or TPL-ID (project or org template)")
    p.add_argument("--title", required=True, help="the template's prefix (e.g. 'Backend:') is added if missing")
    p.add_argument("--description-file", help="markdown following the template's sections ('-' for stdin)")
    p.add_argument("--milestone", type=friendly("MIL"))
    p.add_argument("--deadline", type=deadline_arg, help="YYYY-MM-DD")
    p.add_argument("--assignee", help="project member's email or name")
    p.add_argument("--priority", type=choice(PRIORITIES), help="overrides the template's priority")
    p.add_argument("--client")

    p = cmd(jobs, "update", cmd_job_update,
            "change job fields, keeping all others (a deadline change needs --yes)")
    p.add_argument("job", type=friendly("JOB"))
    project_opt(p)
    p.add_argument("--title")
    p.add_argument("--description-file", help="'-' for stdin")
    p.add_argument("--deadline", type=deadline_arg, help="YYYY-MM-DD, or 'none' to clear")
    p.add_argument("--milestone", help="MIL-ID, or 'none' to clear")
    p.add_argument("--assignee", help="project member's email or name, or 'none'")
    p.add_argument("--priority", type=choice(PRIORITIES))
    p.add_argument("--client", help="'' to clear")

    p = cmd(jobs, "status", cmd_job_status,
            "change a job's status (anything but IN_PROGRESS needs --yes)")
    p.add_argument("job", type=friendly("JOB"))
    p.add_argument("status", type=choice(STATUSES))
    p.add_argument("--reason", help="required for BLOCKED")
    project_opt(p)

    p = cmd(jobs, "block", cmd_job_block, "mark JOB as blocked by another job in the same project")
    p.add_argument("job", type=friendly("JOB"), help="the job that is blocked")
    p.add_argument("--by", required=True, type=friendly("JOB"), help="the job that blocks it")
    project_opt(p)

    links = group("link", "job links (PRs etc.)")
    p = cmd(links, "add", cmd_link_add, "add a link to a job")
    p.add_argument("job", type=friendly("JOB"))
    p.add_argument("url")
    p.add_argument("--label", required=True, help='e.g. "PR #480"')
    project_opt(p)

    p = cmd(links, "merged", cmd_link_merged, 'relabel a job\'s link "<label> (merged)"')
    p.add_argument("job", type=friendly("JOB"))
    p.add_argument("url")
    project_opt(p)

    prs = group("pr", "GitHub pull requests")
    p = cmd(prs, "sync", cmd_pr_sync,
            "sync a PR event to the jobs it references (ADR-0055); exits 0 unless misused")
    p.add_argument("--event", help="GitHub event JSON file ($GITHUB_EVENT_PATH)")
    p.add_argument("--summary", help="append a Markdown table here ($GITHUB_STEP_SUMMARY)")
    p.add_argument("--action", choices=PR_ACTIONS, help="without --event: the PR action")
    p.add_argument("--merged", action="store_true", help="without --event: the PR was merged")
    p.add_argument("--state", choices=("open", "closed"), default="open",
                   help="without --event: the PR's state (an edit to a closed PR moves no status)")
    p.add_argument("--number", type=int, help="without --event: the PR number")
    p.add_argument("--url", help="without --event: the PR URL")
    p.add_argument("--branch", help="without --event: the PR's head branch")
    p.add_argument("--title", help="without --event: the PR title")
    p.add_argument("--body-file", help="without --event: file with the PR body ('-' for stdin)")

    p = cmd(prs, "check", cmd_pr_check,
            "check a PR's title, branch, body and layers against the dev process (ADR-0056); "
            "exits 1 on any failure, needs no API key")
    p.add_argument("--event", help="CI mode: GitHub event JSON file ($GITHUB_EVENT_PATH); needs GITHUB_TOKEN")
    p.add_argument("--summary", help="append a Markdown table here ($GITHUB_STEP_SUMMARY)")
    p.add_argument("--title", help="local mode: the PR title")
    p.add_argument("--body-file", help="local mode: file with the PR body ('-' for stdin)")
    p.add_argument("--branch", help="local mode: the head branch (default: the current git branch)")
    p.add_argument("--labels", help="local mode: comma-separated PR labels, e.g. cross-layer")
    p.add_argument("--base", default="origin/main", help="local mode: files = git diff --name-only <base>...HEAD")

    notes = group("note", "job notes (immutable)")
    p = cmd(notes, "list", cmd_note_list, "show a job's notes")
    p.add_argument("job", type=friendly("JOB"))
    project_opt(p)

    p = cmd(notes, "add", cmd_note_add, "add a note to a job (needs --yes)")
    p.add_argument("job", type=friendly("JOB"))
    src = p.add_mutually_exclusive_group(required=True)
    src.add_argument("--file", help="markdown file ('-' for stdin)")
    src.add_argument("--text")
    project_opt(p)

    templates = group("template", "job templates (project and org level)")
    p = cmd(templates, "list", cmd_template_list, "list templates usable in a project")
    p.add_argument("project", type=friendly("PRJ"))
    p = cmd(templates, "show", cmd_template_show, "show a template's defaults and description skeleton")
    p.add_argument("project", type=friendly("PRJ"))
    p.add_argument("name", help="template name or TPL-ID")

    projects = group("project", "projects")
    p = cmd(projects, "list", cmd_project_list, "list active projects")
    p.add_argument("--all", action="store_true", help="include completed and archived projects")
    p = cmd(projects, "create", cmd_project_create, "create a project (needs --yes)")
    p.add_argument("--name", required=True)
    p.add_argument("--description-file", help="'-' for stdin")

    milestones = group("milestone", "milestones")
    p = cmd(milestones, "list", cmd_milestone_list, "list a project's milestones")
    p.add_argument("project", type=friendly("PRJ"))
    p = cmd(milestones, "create", cmd_milestone_create, "create a milestone (needs --yes)")
    p.add_argument("project", type=friendly("PRJ"))
    p.add_argument("--name", required=True)
    p.add_argument("--description")
    p.add_argument("--deadline", type=date_arg, help="YYYY-MM-DD")

    return parser


# --------------------------------------------------------------------------- main


def load_key(env: Dict[str, str]) -> str:
    """OPSCLEAR_API_KEY, else the first line of OPSCLEAR_KEY_FILE or ~/.config/opsclear/api-key."""
    key = (env.get("OPSCLEAR_API_KEY") or "").strip()
    if key:
        return key
    path = env.get("OPSCLEAR_KEY_FILE")
    if not path and env.get("HOME"):
        path = os.path.join(env["HOME"], ".config", "opsclear", "api-key")
    if not path:
        return ""
    try:
        with open(path, encoding="utf-8") as f:
            return f.readline().strip()
    except OSError:
        return ""


def main(argv: Optional[List[str]] = None, env: Optional[Dict[str, str]] = None,
         transport: Transport = urllib_transport, stdout=None, stderr=None,
         today: Optional[date] = None, sleep: Callable[[float], None] = time.sleep,
         retry_delays: Tuple[float, ...] = RETRY_DELAYS) -> int:
    env = os.environ if env is None else env
    key = load_key(env)
    out = Output(key, stdout, stderr)
    parser = build_parser()
    try:
        with contextlib.redirect_stdout(out.stdout), contextlib.redirect_stderr(out.stderr):
            args = parser.parse_args(argv)
    except SystemExit as e:
        return int(e.code or 0)
    if getattr(args, "group", "") == "pr" and args.action == "check":
        # needs no OpsClear key: a CI run has none and local runs shouldn't need one
        ctx = Ctx(api=Api(DEFAULT_URL, "", transport), out=out, json=args.json, yes=args.yes,
                  dry_run=args.dry_run, today=today or date.today(), sleep=sleep, retry_delays=retry_delays,
                  env=dict(env))
        try:
            return args.func(ctx, args)
        except argparse.ArgumentTypeError as e:
            out.warn(f"error: {e}")
            return EXIT_USAGE
        except CliError as e:
            out.warn(f"error: {e}")
            return EXIT_ERROR
    if not key and getattr(args, "group", "") == "pr":
        try:
            read_pr_event(args)
        except (argparse.ArgumentTypeError, CliError) as e:
            out.warn(f"error: {e}")
            return EXIT_USAGE
        out.print("::notice::OPSCLEAR_API_KEY is not set, nothing synced.")
        return EXIT_OK
    if not key:
        out.warn("error: OPSCLEAR_API_KEY is not set and no key file was found. Create a key in OpsClear "
                 "(Settings > API Keys) and put it in ~/.config/opsclear/api-key (chmod 600).")
        return EXIT_ERROR
    api = Api(env.get("OPSCLEAR_URL") or DEFAULT_URL, key, transport)
    ctx = Ctx(api=api, out=out, json=args.json, yes=args.yes, dry_run=args.dry_run, today=today or date.today(),
               sleep=sleep, retry_delays=retry_delays)
    try:
        return args.func(ctx, args)
    except argparse.ArgumentTypeError as e:
        out.warn(f"error: {e}")
        return EXIT_USAGE
    except CliError as e:
        out.warn(f"error: {e}")
        return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main())
