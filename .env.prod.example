# Copy this file to .env.prod and fill in the values.
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# ── Host ──────────────────────────────────────────────────────────────────────
# The address browsers use to reach this server.
#   Local (same machine):  APP_HOST=host.docker.internal
#   VPS:                   APP_HOST=1.2.3.4  or  APP_HOST=your.domain.com
APP_HOST=host.docker.internal

# ── Ports ─────────────────────────────────────────────────────────────────────
# Defaults are shifted from dev compose to allow running both simultaneously.
APP_PORT=8443          # frontend  → https://localhost:8443
KEYCLOAK_PORT=8280     # keycloak  → http://localhost:8280
PORTAINER_PORT=9001    # portainer → http://localhost:9001

# ── Credentials ───────────────────────────────────────────────────────────────
DB_PASSWORD=opsclear
KEYCLOAK_ADMIN_PASSWORD=admin

# ── Keycloak realm (usually no need to change) ────────────────────────────────
KEYCLOAK_REALM=opsclear
KEYCLOAK_CLIENT_ID=opsclear-frontend

# ── Paddle (ADR-0044, JOB-171) ─────────────────────────────────────────────────
# Sandbox values during JOB-171-179; switching to live keys is a deliberate,
# separate step (JOB-180), never done by just editing this file.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
