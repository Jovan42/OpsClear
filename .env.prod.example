# Copy this file to .env.prod and fill in the values.
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# ── Host ──────────────────────────────────────────────────────────────────────
# The address browsers use to reach this server.
#   Local (same machine):  APP_HOST=host.docker.internal

# Public URL of the app, when it's a domain on the standard HTTPS port (production:
# APP_URL=https://opsclear.app). Leave empty to build every URL as https://APP_HOST:APP_PORT.
# Don't put :443 in it: browsers send the origin without it, so CORS and the token issuer wouldn't match.
APP_URL=
#   VPS:                   APP_HOST=1.2.3.4  or  APP_HOST=your.domain.com
APP_HOST=host.docker.internal

# ── Ports ─────────────────────────────────────────────────────────────────────
# Defaults are shifted from dev compose to allow running both simultaneously.
APP_PORT=8443          # frontend  → https://localhost:8443 (only used to build URLs when APP_URL is empty)
KEYCLOAK_PORT=8280     # keycloak  → http://localhost:8280
PORTAINER_PORT=9001    # portainer → http://localhost:9001

# ── Credentials ───────────────────────────────────────────────────────────────
DB_PASSWORD=opsclear
KEYCLOAK_ADMIN_PASSWORD=admin

# ── Keycloak realm (usually no need to change) ────────────────────────────────
KEYCLOAK_REALM=opsclear
KEYCLOAK_CLIENT_ID=opsclear-frontend

# ── Paddle (ADR-0044, JOB-171) ─────────────────────────────────────────────────
# Sandbox values during JOB-171-179; switching to live keys is a deliberate,
# separate step (JOB-180), never done by just editing this file.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=

# ── Email (ADR-0059) ──────────────────────────────────────────────────────────
# SMTP relay for Keycloak (verification emails) and the backend (invites).
# Brevo: host smtp-relay.brevo.com, user = your Brevo login, password = an SMTP key.
# Use port 2525: DigitalOcean blocks outbound 587 and 465.
# Keycloak gets these via scripts/keycloak-apply-email.sh, the backend via docker-compose.prod.yml.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
# Where replies to app emails go, also shown in the backend email footer (ADR-0064): support@opsclear.app.
# Optional; empty means no Reply-To. After a change: restart the backend, re-run scripts/keycloak-apply-email.sh.
SMTP_REPLY_TO=
SMTP_AUTH=
SMTP_STARTTLS=
# Base URL used in links inside emails. Set by docker-compose.prod.yml from APP_URL (or APP_HOST and APP_PORT);
# only set it here if you want to override that.
APP_BASE_URL=

# ── Sign-up (ADR-0066) ────────────────────────────────────────────────────────
# false until launch: only super users can create organisations, invites still work. Empty means true.
# Launch day: set true and restart the backend (docs/dev/DEPLOY.md, "Launch day: reopen sign-up").
OPSCLEAR_SIGNUP_OPEN=

# ── Database backups (JOB-421, docs/dev/BACKUP.md) ────────────────────────────
# Read only by scripts/backup-db.sh. Spaces bucket in a different region from the droplet.
BACKUP_S3_ENDPOINT=      # https://<region>.digitaloceanspaces.com
BACKUP_S3_REGION=        # e.g. ams3
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Ping URL of the dead-man's switch check (healthchecks.io): alerts on failure and on a missed night.
BACKUP_HEALTHCHECK_URL=
