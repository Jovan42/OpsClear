		{
			"name": "Jobs",
			"item": [
				{
					"name": "Update Job Status (complete; gated Member → 202 completion request)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Completed (200) or completion requested (202)\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 202]);",
									"});",
									"",
									"if (pm.response.code === 202) {",
									"    pm.test(\"Job still In Progress with a pending completion approval\", function () {",
									"        var jsonData = pm.response.json();",
									"        pm.expect(jsonData.status).to.eql('IN_PROGRESS');",
									"        pm.expect(jsonData.pendingCompletionApproval).to.not.be.null;",
									"        pm.environment.set('approvalId', jsonData.pendingCompletionApproval.id);",
									"    });",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"COMPLETED\",\n  \"message\": \"All panels installed, please check\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/projects/{{projectId}}/jobs/{{jobId}}/status",
							"host": ["{{baseUrl}}"],
							"path": ["api", "projects", "{{projectId}}", "jobs", "{{jobId}}", "status"]
						},
						"description": "Change a job's status. Body: `status`, `reason` (required for BLOCKED) and optional `message` (max 2000 characters, used only for completion requests).\n\nADR-0052: on a project with `requireCompletionApproval` on, a **Member** completing a job gets **202 Accepted**: the job stays `IN_PROGRESS` and a completion approval (`kind = COMPLETION`, description = message or \"Requesting to complete this job\") is created and returned in `pendingCompletionApproval` (`id`, `requesterId`, `requesterName`, `requestedAt`, `message`). A second request while one is pending returns **409**. Owners/Admins, ungated projects, and orgs whose `APPROVALS` add-on isn't usable for writes (missing or subscription `PAST_DUE`) complete directly with **200**."
					},
					"response": [
						{
							"name": "202 completion requested (gated Member)",
							"originalRequest": {
								"method": "PATCH",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"status\": \"COMPLETED\",\n  \"message\": \"All panels installed, please check\"\n}"
								},
								"url": {
									"raw": "{{baseUrl}}/api/projects/{{projectId}}/jobs/{{jobId}}/status",
									"host": ["{{baseUrl}}"],
									"path": ["api", "projects", "{{projectId}}", "jobs", "{{jobId}}", "status"]
								}
							},
							"status": "Accepted",
							"code": 202,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n  \"id\": \"{{jobId}}\",\n  \"friendlyId\": \"JOB-042\",\n  \"projectId\": \"{{projectId}}\",\n  \"title\": \"Install solar panel\",\n  \"status\": \"IN_PROGRESS\",\n  \"priority\": \"MEDIUM\",\n  \"assignedTo\": \"{{memberId}}\",\n  \"assignedToName\": \"Carol\",\n  \"links\": [],\n  \"relationships\": [],\n  \"pendingCompletionApproval\": {\n    \"id\": \"7d0c5a1e-2f4b-4c8e-9a51-3b6f0e2d9c11\",\n    \"requesterId\": \"{{memberId}}\",\n    \"requesterName\": \"Carol\",\n    \"requestedAt\": \"2026-11-13T10:15:00Z\",\n    \"message\": \"All panels installed, please check\"\n  }\n}"
						},
						{
							"name": "200 completed directly (Owner/Admin or ungated)",
							"originalRequest": {
								"method": "PATCH",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"status\": \"COMPLETED\",\n  \"message\": \"All panels installed, please check\"\n}"
								},
								"url": {
									"raw": "{{baseUrl}}/api/projects/{{projectId}}/jobs/{{jobId}}/status",
									"host": ["{{baseUrl}}"],
									"path": ["api", "projects", "{{projectId}}", "jobs", "{{jobId}}", "status"]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n  \"id\": \"{{jobId}}\",\n  \"friendlyId\": \"JOB-042\",\n  \"projectId\": \"{{projectId}}\",\n  \"title\": \"Install solar panel\",\n  \"status\": \"COMPLETED\",\n  \"priority\": \"MEDIUM\",\n  \"assignedTo\": \"{{memberId}}\",\n  \"assignedToName\": \"Carol\",\n  \"links\": [],\n  \"relationships\": [],\n  \"pendingCompletionApproval\": null\n}"
