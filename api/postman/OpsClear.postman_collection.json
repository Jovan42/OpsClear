		{
			"name": "Stats",
			"item": [
				{
					"name": "Get Project Stats (default)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Stats returned\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"12 weekly buckets by default\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.weeks).to.eql(12);",
									"    pm.expect(jsonData.buckets).to.have.lengthOf(12);",
									"    pm.expect(jsonData).to.have.property('summary');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/projects/{{projectId}}/stats",
							"host": ["{{baseUrl}}"],
							"path": ["api", "projects", "{{projectId}}", "stats"]
						},
						"description": "Job completion velocity stats for the project (ADR-0050): last 12 weeks in UTC. Requires the DASHBOARD add-on. Owner/Admin get team totals plus `members`; a Member gets only their own stats (`members` is null). Durations are in seconds."
					},
					"response": []
				},
				{
					"name": "Get Project Stats (4 weeks, time zone)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/projects/{{projectId}}/stats?weeks=4&tz=Europe/Belgrade",
							"host": ["{{baseUrl}}"],
							"path": ["api", "projects", "{{projectId}}", "stats"],
							"query": [
								{
									"key": "weeks",
									"value": "4",
									"description": "4, 12 or 26 (default 12). Anything else returns 400."
								},
								{
									"key": "tz",
									"value": "Europe/Belgrade",
									"description": "IANA time zone for week bucketing (default UTC). Invalid returns 400."
								}
							]
						},
						"description": "Last 4 weeks, bucketed into ISO weeks (Monday start) in the given time zone."
					},
					"response": []
				},
				{
					"name": "Get Project Stats (member filter)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/projects/{{projectId}}/stats?memberId={{memberId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "projects", "{{projectId}}", "stats"],
							"query": [
								{
									"key": "memberId",
									"value": "{{memberId}}",
									"description": "User ID. Owner/Admin: any member. Member: only their own ID, anything else returns 403."
								}
							]
						},
						"description": "Stats for one member's jobs (current assignee). `members` is null in the response."
					},
					"response": []
				}
			],
			"description": "Job completion velocity stats (ADR-0050)"
		},
		{
			"name": "Notifications",
			"item": [
				{
					"name": "List Notifications",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Notifications returned\", function () {",
									"    pm.response.to.have.status(200);",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('items');",
									"    pm.expect(jsonData).to.have.property('totalElements');",
									"    if (jsonData.items.length > 0) {",
									"        pm.environment.set(\"notificationId\", jsonData.items[0].id);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/notifications?page=0&size=20",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"notifications"
							],
							"query": [
								{
									"key": "page",
									"value": "0",
									"description": "Zero-based page (default 0). Negative returns 400."
								},
								{
									"key": "size",
									"value": "20",
									"description": "Page size 1 to 100 (default 20). Anything else returns 400."
								}
							]
						},
						"description": "The caller's notifications, newest first (ADR-0051). Paginated: `{ items, page, size, totalElements, totalPages }`, page zero-based. Project-scoped notifications only show while the caller is still a member of that project. Not add-on gated."
					},
					"response": []
				},
				{
					"name": "List Unread Notifications",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/notifications?unread=true",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"notifications"
							],
							"query": [
								{
									"key": "unread",
									"value": "true",
									"description": "true returns only unread notifications."
								},
								{
									"key": "type",
									"value": "JOB_BLOCKED",
									"description": "Optional notification type, e.g. JOB_BLOCKED, NOTE_ADDED. Unknown returns 400.",
									"disabled": true
								}
							]
						},
						"description": "Only unread notifications, optionally filtered by type."
					},
					"response": []
				},
				{
					"name": "Get Unread Count",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Count returned\", function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json()).to.have.property('count');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/notifications/unread-count",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"notifications",
								"unread-count"
							]
						},
						"description": "`{ \"count\": 7 }`: the caller's unread notifications (visibility filter applied)."
					},
					"response": []
				},
				{
					"name": "Mark Notification Read",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"read\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/notifications/{{notificationId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"notifications",
								"{{notificationId}}"
							]
						},
						"description": "Mark one notification read (`true`) or unread (`false`). Returns the notification. Another user's or an unknown ID returns 404. `notificationId` is set by List Notifications."
					},
					"response": []
				},
				{
					"name": "Mark All Notifications Read",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"All marked read\", function () {",
									"    pm.response.to.have.status(204);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/notifications/read-all",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"notifications",
								"read-all"
							]
						},
						"description": "Marks all of the caller's unread notifications read. Returns 204."
					},
					"response": []
				},
				{
					"name": "Notification Stream (SSE)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "text/event-stream"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/notifications/stream",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"notifications",
								"stream"
							]
						},
						"description": "Live notification events for the caller over Server-Sent Events (`text/event-stream`, ADR-0051). Events: `notification` (same shape as a list item), `read-state` (`{ \"ids\": [...], \"read\": true|false }` or `{ \"all\": true }`), and a `:heartbeat` comment on open and every 25 s. No replay: re-fetch the list and unread count on (re)connect. The server closes the stream after 30 minutes; at most 5 open streams per user (the oldest is closed). JWT auth (`Authorization` header). The response stays open: cancel the request in Postman to stop it."
					},
					"response": []
				},
				{
					"name": "Get Notification Settings",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/user/notification-settings",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"user",
								"notification-settings"
							]
						},
						"description": "The caller's muted notification types: `{ \"muted\": [...] }`. Empty by default."
					},
					"response": []
				},
				{
					"name": "Update Notification Settings",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"muted\": [\n    \"JOB_STATUS_CHANGED\",\n    \"NOTE_ADDED\"\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/user/notification-settings",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"user",
								"notification-settings"
							]
						},
						"description": "Replaces the caller's muted types (muted types aren't created for the caller). `SUBSCRIPTION_PAST_DUE` can't be muted (400); an unknown type returns 400."
					},
					"response": []
				}
			],
			"description": "In-app notification centre (ADR-0051)"
		}
	],
