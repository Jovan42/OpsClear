		{
			"name": "Approvals",
			"item": [
				{
					"name": "Decide Approval (approve completion approval)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": ["pm.test(\"Approval decided\", function () {", "    pm.response.to.have.status(200);", "    pm.expect(pm.response.json()).to.have.property('kind');", "});"]
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"APPROVED\",\n  \"comment\": \"Looks good\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/projects/{{projectId}}/jobs/{{jobId}}/approvals/{{approvalId}}/status",
							"host": ["{{baseUrl}}"],
							"path": ["api", "projects", "{{projectId}}", "jobs", "{{jobId}}", "approvals", "{{approvalId}}", "status"]
						},
						"description": "Approve or reject an approval (`status`: APPROVED or REJECTED, optional `comment`). Owner/Admin only; requires the `APPROVALS` add-on.\n\nADR-0052: the response carries `kind` (MANUAL or COMPLETION), `completionApplied` and `completionNotAppliedReason`. Approving a **completion** approval completes the job (history attributed to the approver) if it's still `IN_PROGRESS` (`completionApplied: true`); otherwise the approval is recorded as approved but not applied, with the job's current status as the reason (e.g. `BLOCKED`). Rejecting leaves the job as it is. Manual approvals never change job status; their completion fields are null."
					},
					"response": [
						{
							"name": "200 approved, completion applied",
							"originalRequest": {
								"method": "PATCH",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"status\": \"APPROVED\",\n  \"comment\": \"Looks good\"\n}"
								},
								"url": {
									"raw": "{{baseUrl}}/api/projects/{{projectId}}/jobs/{{jobId}}/approvals/{{approvalId}}/status",
									"host": ["{{baseUrl}}"],
									"path": ["api", "projects", "{{projectId}}", "jobs", "{{jobId}}", "approvals", "{{approvalId}}", "status"]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n  \"id\": \"{{approvalId}}\",\n  \"jobId\": \"{{jobId}}\",\n  \"jobTitle\": \"Install solar panel\",\n  \"requesterId\": \"{{memberId}}\",\n  \"approverId\": \"6a1f3c2d-8b4e-4f7a-9c0d-1e2f3a4b5c6d\",\n  \"description\": \"All panels installed, please check\",\n  \"status\": \"APPROVED\",\n  \"comment\": \"Looks good\",\n  \"requestedAt\": \"2026-11-13T10:15:00Z\",\n  \"decidedAt\": \"2026-11-13T11:02:00Z\",\n  \"kind\": \"COMPLETION\",\n  \"completionApplied\": true,\n  \"completionNotAppliedReason\": null\n}"
						},
						{
							"name": "200 approved, not applied (job was Blocked)",
							"originalRequest": {
								"method": "PATCH",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"status\": \"APPROVED\",\n  \"comment\": \"Looks good\"\n}"
								},
								"url": {
									"raw": "{{baseUrl}}/api/projects/{{projectId}}/jobs/{{jobId}}/approvals/{{approvalId}}/status",
									"host": ["{{baseUrl}}"],
									"path": ["api", "projects", "{{projectId}}", "jobs", "{{jobId}}", "approvals", "{{approvalId}}", "status"]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
